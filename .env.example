# ==============================================================================
# Auto_Translate Environment Configuration Template
# Copy this file to .env locally or set these variables on Render.com dashboard!
# ==============================================================================

# Web server port (Render automatically sets $PORT, default is 8000 locally)
PORT=8000

# Beam search width (1 = fastest, 4 = best translation quality)
BEAM_SIZE=4

# Computation precision (int8 is required to stay below 512MB RAM)
COMPUTE_TYPE=int8

# Max concurrent requests handled simultaneously by the server
MAX_CONCURRENCY=20

# Memory budget ceiling in Megabytes (Render Free Tier limit is 512MB)
MAX_ALLOWED_RAM_MB=512.0

# Number of CPU threads used for matrix multiplication per core
OMP_NUM_THREADS=2

# Directory where Hugging Face downloads model weights
CACHE_DIR=hf_cache

# ==============================================================================
# Model Repositories on Hugging Face (can be swapped or customized)
# ==============================================================================
VI_EN_REPO=dekthedev/opus-mt-vi-en-ct2-int8
MODEL_EN_FR=michaelfeil/ct2fast-opus-mt-en-fr
MODEL_EN_DE=michaelfeil/ct2fast-opus-mt-en-de
MODEL_EN_ES=michaelfeil/ct2fast-opus-mt-en-es
MODEL_EN_ZH=gaudi/opus-mt-en-zh-ctranslate2
MODEL_EN_JA=craftwise/ct2-opus-mt-en-ja-int8
